{
  "name": "@pulse/api",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse API - REST backend for uptime monitoring",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "notification-worker": "tsx watch src/notificationWorker.ts",
    "build": "tsup",
    "start": "node dist/server.cjs",
    "start:worker": "node dist/worker.cjs",
    "start:notification-worker": "node dist/notificationWorker.cjs",
    "start:workers": "node dist/workersRunner.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pulse/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
