# Copy to .env and fill in your own values. Never commit real secrets.
# Every variable read by the app — source of truth: apps/api/src/config/env.ts
# and apps/web (vite.config.ts / lib/api.ts).

# ─── API ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/pulse
REDIS_URL=redis://localhost:6379
# Required in production (startup fails without a non-default value).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed browser origins. Trailing slashes are stripped.
CORS_ORIGIN=http://localhost:5173

# ─── Web ───────────────────────────────────────────────────────────────────
# Optional. When unset, the SPA calls the API with relative URLs ("/api/...")
# through the Vite dev proxy or the nginx proxy. Only set this when the
# frontend is hosted separately from the API (set it at build time).
# VITE_API_URL=https://api.example.com
# Build-time proxy target for `npm run dev` (vite.config.ts).
# API_URL=http://localhost:4000

# ─── Email notifications (optional) ────────────────────────────────────────
# When SMTP_HOST/SMTP_FROM are unset, email is not offered as a channel.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM="Pulse <noreply@example.com>"

# ─── Notification delivery tuning (defaults shown) ─────────────────────────
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_BACKOFF_MS=1000
# NOTIFICATION_WEBHOOK_TIMEOUT_MS=10000
