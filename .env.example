# ─── API ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB (local: mongodb://localhost:27017/pulse | docker: mongodb://mongo:27017/pulse)
MONGODB_URI=mongodb://localhost:27017/pulse

# Redis (local: redis://localhost:6379 | docker: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# Auth — ALWAYS change this in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
